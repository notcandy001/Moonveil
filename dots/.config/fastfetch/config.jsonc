{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        
      "source":"~/.config/fastfetch/ax.png",    
         "type": "auto",                    // 'auto' detects the best protocol for your terminal
        "width": 14,                       // Adjust width (in characters)
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "white"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌─────────────────────────────────┐",
            "outputColor": "37"
        },
        {
            "type": "title",
            "key": " {#34}  title   {#keys}",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "os",
            "key": "{#34}   os      {#keys}"
        },
        {
            "type": "wm",
            "key": "{#34}   de      {#keys}"
        },
        {
            "type": "shell",
            "key": "{#34}   shell   {#keys}"
        },
        {
            "type": "terminal",
            "key": "{#34}   terminal{#keys}"
        },
        {
            "type": "uptime",
            "key": "{#34}  󰔚 uptime  {#keys}"
        },
        {
            "type": "packages",
            "key": " {#34}  package {#keys}"
        },
        {
            "type": "custom",
           "format": "└─────────────────────────────────┘",
	    "outputColor": "37"
                    },
        {
            "type": "custom",
           "format": "{#31}C   {#32}A    {#33}N    {#34}D    {#35}Y    {#0}火"        
	}    
    ]
}
