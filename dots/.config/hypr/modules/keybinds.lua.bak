--  ┓┏┓┏┓┓┏┳┓┳┳┓┳┓┏┓
--  ┃┫ ┣ ┗┫┣┫┃┃┃┃┃┗┓
--  ┛┗┛┗┛┗┛┻┛┻┛┗┻┛┗┛
--   CrescentShell Keybinds


local mainMod = "SUPER"

-------------------------------------------------------------------------------
---- APPLICATION & RUN LAUNCHER -----------------------------------------------
-------------------------------------------------------------------------------

hl.bind(mainMod .. " + RETURN",    hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + Q",         hl.dsp.window.close())
hl.bind(mainMod .. " + B",         hl.dsp.exec_cmd("google-chrome-stable"))
hl.bind(mainMod .. " + E",         hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + V",         hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + P",         hl.dsp.window.pseudo())
hl.bind(mainMod .. " + J",         hl.dsp.layout("togglesplit"))
hl.bind(mainMod .. " + SHIFT + C", hl.dsp.exec_cmd("code ."))
hl.bind(mainMod .. " + SHIFT + T", hl.dsp.exec_cmd("lxappearance"))
hl.bind(mainMod .. " + Print",     hl.dsp.exec_cmd("grim ~/Pictures/$(date +'%Y-%m-%d_%H-%M-%S').png"))

-------------------------------------------------------------------------------
---- CRESCENTSHELL ------------------------------------------------------------
-------------------------------------------------------------------------------

-- Sidebar left (Control Center)
hl.bind(mainMod .. " + A",              hl.dsp.exec_cmd("qs ipc call sidebarLeftToggle"))

-- Wallpaper selector
hl.bind(mainMod .. " + SHIFT + W",      hl.dsp.exec_cmd("qs ipc call wallpaperSelectorToggle"))

-- Sidebar right (Notifications)
hl.bind(mainMod .. " + N",              hl.dsp.exec_cmd("qs ipc call sidebarRightToggle"))

-- Overview / Launcher
-- hl.bind(mainMod .. " + Tab",         hl.dsp.exec_cmd("qs ipc call overviewWorkspacesToggle"))
hl.bind(mainMod .. " + R",              hl.dsp.exec_cmd("qs ipc call searchToggle"))

-- Cheatsheet
hl.bind(mainMod .. " + slash",          hl.dsp.exec_cmd("qs ipc call cheatsheetToggle"))

-- Lock screen
hl.bind(mainMod .. " + L",              hl.dsp.exec_cmd("qs ipc call lock"))

-- Settings
hl.bind(mainMod .. " + I",              hl.dsp.exec_cmd("qs ipc call settingsOpen"))

-- Session / Power menu
hl.bind(mainMod .. " + SHIFT + Escape", hl.dsp.exec_cmd("qs ipc call sessionOpen"))

-- Screen snip
hl.bind(mainMod .. " + SHIFT + S",      hl.dsp.exec_cmd("qs ipc call regionScreenshot"))

-- Bar toggle
hl.bind(mainMod .. " + ALT + B",        hl.dsp.exec_cmd("qs ipc call barToggle"))

-- Overview toggle
hl.bind("SUPER + TAB",                  hl.dsp.exec_cmd("qs ipc -c overview call overview toggle"))

-------------------------------------------------------------------------------
---- MOVE FOCUS ---------------------------------------------------------------
-------------------------------------------------------------------------------

hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left"  }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up"    }))
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down"  }))

-------------------------------------------------------------------------------
---- SWITCH WORKSPACES --------------------------------------------------------
-------------------------------------------------------------------------------

for i = 1, 9 do
    hl.bind(mainMod .. " + " .. i,         hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. i, hl.dsp.window.move({ workspace = i }))
end
hl.bind(mainMod .. " + 0",         hl.dsp.focus({ workspace = 10 }))
hl.bind(mainMod .. " + SHIFT + 0", hl.dsp.window.move({ workspace = 10 }))

-------------------------------------------------------------------------------
---- SPECIAL WORKSPACE (SCRATCHPAD) -------------------------------------------
-------------------------------------------------------------------------------

hl.bind(mainMod .. " + S",        hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + CTRL + S", hl.dsp.window.move({ workspace = "special:magic" }))

-------------------------------------------------------------------------------
---- SCROLL THROUGH WORKSPACES ------------------------------------------------
-------------------------------------------------------------------------------

hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-------------------------------------------------------------------------------
---- MOVE / RESIZE WINDOWS ----------------------------------------------------
-------------------------------------------------------------------------------

hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-------------------------------------------------------------------------------
---- VOLUME, MIC & BACKLIGHT --------------------------------------------------
-------------------------------------------------------------------------------

hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
hl.bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   { locked = true, repeating = true })
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  { locked = true, repeating = true })

-------------------------------------------------------------------------------
---- MEDIA PLAYER -------------------------------------------------------------
-------------------------------------------------------------------------------

hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })
